generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUBSCRIBER
  ADMIN
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  INCOMPLETE // checkout started, not yet confirmed by webhook
  ACTIVE
  PAST_DUE
  CANCELED
  LAPSED
}

enum DrawType {
  RANDOM
  ALGORITHMIC
}

enum DrawStatus {
  DRAFT // created, not yet simulated
  SIMULATED // simulated, numbers/pool visible to admin only
  PUBLISHED // results live, winners notified
}

enum MatchTier {
  FIVE
  FOUR
  THREE
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ─────────────────────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SUBSCRIBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription  Subscription?
  scores        Score[]
  drawTickets   DrawTicket[]
  winnerClaims  WinnerClaim[]     @relation("ClaimOwner")
  reviewedClaims WinnerClaim[]    @relation("ClaimReviewer")
  refreshTokens RefreshToken[]

  @@index([email])
}

// One-per-user refresh token store so tokens can be revoked individually
// (e.g. on logout or password change) rather than trusting a stateless JWT forever.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Charity {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(INCOMPLETE)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean @default(false)

  charityId              String?
  charity                Charity? @relation(fields: [charityId], references: [id])
  charityContributionPct Int      @default(10) // PRD §08: minimum 10%, user may increase

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([stripeCustomerId])
}

// Only the latest 5 scores are retained per user (PRD §05).
// Enforced in application logic (scores.service.ts), not just this schema,
// because "replace oldest on 6th insert" is a business rule, not a DB constraint.
model Score {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // Stableford points, 1–45
  playedOn  DateTime // date of the round (date-only, time ignored)
  createdAt DateTime @default(now())

  @@unique([userId, playedOn]) // one entry per user per date (PRD §05 note)
  @@index([userId, playedOn])
}

// ─────────────────────────────────────────────────────────────
// DRAW ENGINE MODELS
// See ASSUMPTIONS.md §1–3 for the reasoning behind this shape.
// ─────────────────────────────────────────────────────────────

model Draw {
  id     String     @id @default(cuid())
  month  Int // 1-12
  year   Int
  type   DrawType
  status DrawStatus @default(DRAFT)

  // Snapshot fields — locked at simulate time, never recalculated live.
  eligibleSubscriberCount Int?
  totalPoolAmount         Decimal? @db.Decimal(12, 2)
  poolShareFive           Decimal? @db.Decimal(12, 2) // 40%
  poolShareFour           Decimal? @db.Decimal(12, 2) // 35%
  poolShareThree          Decimal? @db.Decimal(12, 2) // 25%

  // Rollover / forfeiture tracking (ASSUMPTIONS.md §3)
  jackpotRolloverIn  Decimal @default(0) @db.Decimal(12, 2)
  jackpotRolloverOut Decimal @default(0) @db.Decimal(12, 2)

  winningNumbers Int[] // the drawn winning ticket, set at simulate time

  simulatedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  tickets DrawTicket[]
  results DrawResult[]

  @@unique([month, year]) // one draw per calendar month
}

model DrawTicket {
  id     String @id @default(cuid())
  drawId String
  draw   Draw   @relation(fields: [drawId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  numbers Int[] // the 5-number ticket issued to this subscriber for this cycle
  matchTier MatchTier? // null if no match

  createdAt DateTime @default(now())

  @@unique([drawId, userId])
  @@index([drawId])
}

model DrawResult {
  id        String    @id @default(cuid())
  drawId    String
  draw      Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  matchTier MatchTier
  poolAmount Decimal  @db.Decimal(12, 2)
  winnerUserIds String[] // denormalized for quick display; source of truth is DrawTicket.matchTier

  createdAt DateTime @default(now())

  @@unique([drawId, matchTier])
}

model WinnerClaim {
  id           String      @id @default(cuid())
  drawResultId String
  userId       String
  user         User        @relation("ClaimOwner", fields: [userId], references: [id], onDelete: Cascade)

  proofUrl   String?
  status     ClaimStatus @default(PENDING)
  amountDue  Decimal     @db.Decimal(12, 2)

  reviewedById String?
  reviewedBy   User?   @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectionReason String?

  submittedAt DateTime  @default(now())
  paidAt      DateTime?

  @@index([drawResultId])
  @@index([status])
}
