# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard. Must include ?sslmode=require
DATABASE_URL=""

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxxxxxxxxx

# --- File uploads (winner proof screenshots) ---
# Local disk storage is used by default (see src/config/upload.ts).
# Swap in S3/Cloudinary here for production.
UPLOAD_DIR=uploads

# --- Draw engine ---
DRAW_TICKET_NUMBER_RANGE=49
DRAW_TICKET_LENGTH=5
PRIZE_POOL_CONTRIBUTION_PCT=20
