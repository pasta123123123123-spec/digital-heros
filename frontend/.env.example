# The frontend calls the API via the relative /api path, proxied to the
# backend in dev (see vite.config.ts) and same-origin in production if you
# deploy the backend behind the same domain/reverse proxy as the frontend.
#
# If you deploy the frontend and backend to DIFFERENT origins (e.g. two
# separate Vercel projects), set this and update src/api/client.ts's
# baseURL to use it instead of the hardcoded '/api'.
VITE_API_URL=http://localhost:4000/api
